etry x="70" y="865" width="370" height="75" as="geometry" /></mxCell><mxCell id="cast" parent="1" vertex="1" value="CAST 抛出&#10;抛出阶段松手会记录展开请求" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e6f4ef;strokeColor=#27765a;fontSize=16;"><mxGeometry x="630" y="270" width="380" height="60" as="geometry" /></mxCell><mxCell id="descend" parent="1" vertex="1" value="DESCEND 下沉&#10;松手到最小深度 / 到底自动展开" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e6f4ef;strokeColor=#27765a;fontSize=16;"><mxGeometry x="630" y="380" width="380" height="65" as="geometry" /></mxCell><mxCell id="open" parent="1" vertex="1" value="OPEN 展开 → HOLD 短暂捕获&#10;六格容量；大生物两格" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e6f4ef;strokeColor=#27765a;fontSize=16;"><mxGeometry x="630" y="490" width="380" height="75" as="geometry" /></mxCell><mxCell id="haul" parent="1" vertex="1" value="RETRACT 回船&#10;满载或捕获窗结束触发" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e6f4ef;strokeColor=#27765a;fontSize=16;"><mxGeometry x="630" y="610" width="380" height="65" as="geometry" /></mxCell><mxCell id="ret" parent="1" vertex="1" value="return：鱼获、分数入账&#10;移除在途网，才释放下一网投掷资格" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e6f4ef;strokeColor=#27765a;fontSize=16;"><mxGeometry x="630" y="720" width="380" height="75" as="geometry" /></mxCell><mxCell id="note0" parent="1" vertex="1" value="来源：src/main.js、src/core/FishingSimulation.js、docs/CURRENT_PRODUCT.md。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#526474;fontSize=16;strokeColor=none;fontSize=13;"><mxGeometry x="40" y="980" width="1020" height="25" as="geometry" /></mxCell><mxCell id="note1" parent="1" vertex="1" value="暂停时网不推进；DRAINING继续右侧收网。收藏/分享为旁路，未展开所有界面。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#526474;fontSize=16;strokeColor=none;fontSize=13;"><mxGeometry x="40" y="1005" width="1020" height="25" as="geometry" /></mxCell><mxCell id="note2" parent="1" vertex="1" value="旧存档可能带历史多网：先兼容收完，再按单网规则；图描述正常新局。" s